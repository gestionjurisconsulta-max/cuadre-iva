# Copia este fichero a .env y ajusta lo que haga falta.
#
#     cp .env.example .env
#     docker compose up -d
#     docker compose exec api python gestion_usuarios.py crear <usuario> "<Nombre>"
#
# .env no se versiona: lleva la contraseña de la base.
#
# Los valores de aquí son los de desarrollo. Lo que hay que cambiar sí o sí
# antes de subir al VPS va marcado con «VPS:». Está todo junto en DESPLIEGUE.md.

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=cuadre
POSTGRES_USER=cuadre
# VPS: CÁMBIALA. La de aquí vale solo para desarrollo.
#      openssl rand -base64 30
POSTGRES_PASSWORD=cuadre
# Se publica solo en 127.0.0.1, para poder mirar la base desde el propio
# servidor. El 5434 porque el 5432 y el 5433 están cogidos en la máquina de
# desarrollo; en el VPS comprueba con «ss -tlnp» y cambia el número si hace
# falta. Si no necesitas mirar la base, comenta el «ports» de db en el compose
# y deja de ser alcanzable del todo, que es mejor todavía.
POSTGRES_PORT=5434

# --- La aplicación ---------------------------------------------------------
# Dónde escucha el frontend EN LA MÁQUINA. Por defecto solo en el loopback: en
# el VPS hay más proyectos y quien publica hacia fuera es el proxy del servidor,
# no este compose. Ponerlo a 0.0.0.0 abre la aplicación a internet por http sin
# TLS, y como docker escribe sus reglas antes que ufw, el cortafuegos no lo
# tapa. Solo tiene sentido en una máquina de desarrollo aislada.
CUADRE_ESCUCHA=127.0.0.1
# Puerto por el que entra el proxy. El 8080 no, que lo declara el dashboard de
# carpetas; si el 8081 también estuviera cogido en el VPS, pon otro y ya está.
CUADRE_PUERTO=8081

# Cuántos cuadres a la vez. Cada uno se come una CPU durante ~30 s, así que no
# tiene sentido pasar del número de núcleos del VPS —y el VPS es compartido con
# otros proyectos, así que déjales núcleos a ellos también—.
CUADRE_TRABAJADORES=2

# VPS: ponlo a 1. Con https delante, la cookie de sesión deja de viajar por http.
CUADRE_COOKIE_SEGURA=0
CUADRE_DIAS_SESION=14

# Los libros de un cliente no se quedan en el servidor para siempre.
CUADRE_RETENCION_DIAS=30
CUADRE_MAX_SUBIDA_MB=200
CUADRE_LOG=INFO

# La lista de sociedades del despacho, en JSON: {"B01709237": "NOMBRE SL", ...}.
# Sirve para avisar cuando en el numero de factura se ha colado el NIF de una de
# vuestras sociedades. Son NIF de clientes, asi que el fichero NO va en el
# repositorio: se monta desde fuera. Sin el, el cuadre funciona igual y solo
# pierde ese aviso. Mira mis_empresas.example.json para el formato.
# VPS: apúntalo al de verdad, p. ej. /srv/cuadre-iva/mis_empresas.json
CUADRE_SOCIEDADES_FICHERO=./mis_empresas.example.json

# --- Solo para desarrollo fuera de docker ----------------------------------
# CUADRE_BD=postgresql://cuadre:cuadre@localhost:5434/cuadre
# CUADRE_BD_TESTS=postgresql://cuadre:cuadre@localhost:5434/postgres
# CUADRE_DATOS=/ruta/a/los/libros/del/2T
