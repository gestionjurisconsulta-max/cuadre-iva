# Copia este fichero a .env y ajusta lo que haga falta.
#
#     cp .env.example .env
#     docker compose up -d db
#
# .env no se versiona: lleva la contrasena de la base.

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=cuadre
POSTGRES_USER=cuadre
# Cambiala antes de subir al VPS. La de aqui vale solo para desarrollo.
POSTGRES_PASSWORD=cuadre
# El 5433 y no el 5432, para no chocar con un PostgreSQL instalado en la maquina.
POSTGRES_PORT=5433

# --- La aplicacion ---------------------------------------------------------
# DSN del historico. Desde fuera de docker apunta al puerto publicado; desde un
# contenedor, el host es el nombre del servicio: postgresql://cuadre:cuadre@db:5432/cuadre
CUADRE_BD=postgresql://cuadre:cuadre@localhost:5433/cuadre

# Servidor que usan los tests para crear y tirar sus bases desechables. Apunta a
# la base 'postgres' de mantenimiento, no a la del historico.
CUADRE_BD_TESTS=postgresql://cuadre:cuadre@localhost:5433/postgres

# Carpeta con los libros del 2T 2026 que necesita tests/test_regresion.py.
# CUADRE_DATOS=/ruta/a/los/libros

# --- Sesiones --------------------------------------------------------------
# En el VPS ponlo a 1: la cookie de sesión solo viajará por https.
CUADRE_COOKIE_SEGURA=0
# Días que dura una sesión sin volver a entrar.
CUADRE_DIAS_SESION=14
